(module socket
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes
    (CHAIN_INTERCEPT_BEFORE EVENT_ACCEPT EVENT_ACCEPT4 EVENT_BIND EVENT_CONNECT EVENT_GETPEERNAME EVENT_GETSOCKNAME EVENT_GETSOCKOPT EVENT_SETSOCKOPT EVENT_LISTEN EVENT_RECV EVENT_RECVFROM EVENT_RECVMSG EVENT_SEND EVENT_SENDTO EVENT_SENDMSG EVENT_SHUTDOWN EVENT_SOCKET EVENT_SOCKETPAIR)
    (CHAIN_INTERCEPT_AFTER EVENT_ACCEPT EVENT_ACCEPT4 EVENT_BIND EVENT_CONNECT EVENT_GETPEERNAME EVENT_GETSOCKNAME EVENT_GETSOCKOPT EVENT_SETSOCKOPT EVENT_LISTEN EVENT_RECV EVENT_RECVFROM EVENT_RECVMSG EVENT_SEND EVENT_SENDTO EVENT_SENDMSG EVENT_SHUTDOWN EVENT_SOCKET EVENT_SOCKETPAIR))
)
