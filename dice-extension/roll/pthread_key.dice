(module pthread_key
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes
    (CHAIN_INTERCEPT_BEFORE EVENT_PTHREAD_KEY_CREATE EVENT_PTHREAD_KEY_DELETE EVENT_PTHREAD_SETSPECIFIC EVENT_PTHREAD_GETSPECIFIC)
    (CHAIN_INTERCEPT_AFTER EVENT_PTHREAD_KEY_CREATE EVENT_PTHREAD_KEY_DELETE EVENT_PTHREAD_SETSPECIFIC EVENT_PTHREAD_GETSPECIFIC)))
