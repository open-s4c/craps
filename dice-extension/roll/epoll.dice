(module epoll
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes
    (CHAIN_INTERCEPT_BEFORE EVENT_EPOLL_CREATE EVENT_EPOLL_CREATE1 EVENT_EPOLL_CTL EVENT_EPOLL_WAIT EVENT_EPOLL_PWAIT EVENT_EPOLL_PWAIT2)
    (CHAIN_INTERCEPT_AFTER EVENT_EPOLL_CREATE EVENT_EPOLL_CREATE1 EVENT_EPOLL_CTL EVENT_EPOLL_WAIT EVENT_EPOLL_PWAIT EVENT_EPOLL_PWAIT2))
)
