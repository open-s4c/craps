(module uio
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes
    (CHAIN_INTERCEPT_BEFORE EVENT_READV EVENT_WRITEV EVENT_PREADV EVENT_PREADV64 EVENT_PREADV2 EVENT_PREADV64V2 EVENT_PWRITEV EVENT_PWRITEV64 EVENT_PWRITEV2 EVENT_PWRITEV64V2)
    (CHAIN_INTERCEPT_AFTER EVENT_READV EVENT_WRITEV EVENT_PREADV EVENT_PREADV64 EVENT_PREADV2 EVENT_PREADV64V2 EVENT_PWRITEV EVENT_PWRITEV64 EVENT_PWRITEV2 EVENT_PWRITEV64V2))
)
