(module fcntl
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes
    (CHAIN_INTERCEPT_BEFORE EVENT_CREAT EVENT_FCNTL EVENT_OPEN EVENT_OPENAT EVENT_OPENAT64 EVENT_POSIX_FADVISE EVENT_POSIX_FALLOCATE EVENT_OPEN64)
    (CHAIN_INTERCEPT_AFTER EVENT_CREAT EVENT_FCNTL EVENT_OPEN EVENT_OPENAT EVENT_OPENAT64 EVENT_POSIX_FADVISE EVENT_POSIX_FALLOCATE EVENT_OPEN64)))
